      "sql": "SELECT * FROM customers WHERE country = 'Mexico'",
      "naiveSql": "SELECT * FROM customers WHERE country = 'Mexico'"
    },
    {
      "id": "q04",
      "text": "Pedidos con monto mayor a 100",
      "template": "filter_gt",
      "params": { "table": "orders", "column": "amount", "value": 100 },
      "sql": "SELECT * FROM orders WHERE amount > 100",
      "naiveSql": "SELECT * FROM orders WHERE amount > 100"
    },
    {
      "id": "q05",
      "text": "Monto total de pedidos",
      "template": "aggregate_sum",
      "params": { "table": "orders", "column": "amount" },
      "sql": "SELECT SUM(amount) FROM orders",
      "naiveSql": "SELECT SUM(total) FROM orders"
    },
    {
      "id": "q06",
      "text": "Pedidos por estado",
      "template": "group_count",
      "params": { "table": "orders", "column": "status" },
      "sql": "SELECT status, COUNT(*) FROM orders GROUP BY status",
      "naiveSql": "SELECT status, COUNT(*) FROM orders GROUP BY status"
    },
    {
      "id": "q07",
      "text": "Cliente con más pedidos",
      "template": "top_join_count",
      "params": { "limit": 1 },
      "sql": "SELECT c.name, COUNT(o.id) AS n FROM customers c JOIN orders o ON o.customer_id = c.id GROUP BY c.name ORDER BY n DESC LIMIT 1",
      "naiveSql": "SELECT name FROM users ORDER BY orders DESC"
    },
    {
      "id": "q08",
